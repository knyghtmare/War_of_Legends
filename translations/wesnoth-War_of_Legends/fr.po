#. [resistance], id=spellguard
#: .\macros\abilities-new.cfg:450
msgid "spellguard"
msgstr "gardesort"

#. [resistance], id=spellguard
#: .\macros\abilities-new.cfg:451
msgid "Adjacent units receive a +10%/+20%/+30% (varies by the ability user level) bonus to all magical resistances (up to a maximum of 30%)."

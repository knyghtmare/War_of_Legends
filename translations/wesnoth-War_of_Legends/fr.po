msgstr "ruée des ombres"

#. [skirmisher], id=shadowdash
#: .\macros\abilities-new.cfg:487
msgid "female^shadowdash"
msgstr "ruée des ombres"

#. [skirmisher], id=shadowdash
#: .\macros\abilities-new.cfg:488
msgid "During the night or in dark underground areas, this unit can move past enemies quickly, and ignores all enemy Zones of Control."
msgstr "Pendant la nuit ou dans les zones souterraines sombres, cette unité peut passer rapidement à côté des ennemis et ignorer toutes les Zones de Contrôle ennemies."

#. [heals], id=heals_undead_6hp

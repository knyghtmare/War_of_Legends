#. [heals], id=heals_minotaur
#: .\macros\abilities-new.cfg:367
msgid "female^heals minotaur +4"
msgstr "soins minotaures +4"

#. [heals], id=heals_minotaur
#: .\macros\abilities-new.cfg:368
